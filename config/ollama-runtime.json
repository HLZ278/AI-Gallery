  "installDirEnv": "LOCALAPPDATA",
  "installRelativePath": "Programs/Ollama/ollama.exe",
  "gpuEnv": {
    "OLLAMA_VULKAN": "1",
    "OLLAMA_NUM_PARALLEL": "1",
    "OLLAMA_MAX_LOADED_MODELS": "1"
  },
  "serveStartupWaitMs": 8000,
  "installPollIntervalMs": 1000,
  "installPollMaxAttempts": 120
}
